# Copy to .env.local for local dev, or add these in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set, the app uses live ESPN stats and keeps slips in the browser.

# Data feed: espn (default, no key), sample (demo data), or balldontlie (needs the key below; NBA only).
DATA_SOURCE=espn
BALLDONTLIE_API_KEY=

# Free Redis database for synced slips and cached team defense. Adding Upstash Redis from the
# Vercel Marketplace sets the KV_ pair automatically; a direct Upstash setup uses the UPSTASH_ names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: reads Pick 6 screenshots with Claude (more accurate than the free on-device reader).
# Get a key at console.anthropic.com. Costs roughly a cent per screenshot.
ANTHROPIC_API_KEY=

# Optional: auto-fills prop lines when you open a game (Pick 6 lines first, sportsbooks as backup).
# Free key at the-odds-api.com: 500 credits a month. Opening a game costs about one credit per stat
# type (8 for an NBA game), cached for two hours and shared by everyone using the site.
ODDS_API_KEY=

# Protects /api/cron/refresh. Vercel sends it automatically to its own cron jobs.
CRON_SECRET=
